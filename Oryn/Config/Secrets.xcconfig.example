// Secrets.xcconfig.example  ← committed template; actual Secrets.xcconfig is gitignored.
//
// Copy this file to Secrets.xcconfig and fill in whichever keys you plan to use:
//   cp Oryn/Config/Secrets.xcconfig.example Oryn/Config/Secrets.xcconfig
//
// The app builds cleanly without any of these — each integration gracefully
// degrades to a local / disconnected fallback when its key is missing.
// Values defined here override the defaults in Config.xcconfig.

// ──────────────────────────────────────────────────────────────
// AI Insights — Anthropic Claude (https://console.anthropic.com/)
// When empty, Insights falls back to the built-in rule-based engine.
// ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY =

// ──────────────────────────────────────────────────────────────
// Microsoft / Outlook — Azure AD app registration
// https://portal.azure.com → App registrations (native / public client)
// Redirect URI must be: msauth.com.oryn://auth
// ──────────────────────────────────────────────────────────────
OUTLOOK_CLIENT_ID =

// ──────────────────────────────────────────────────────────────
// Google Calendar — iOS OAuth client
// https://console.cloud.google.com → APIs & Services → Credentials
// ──────────────────────────────────────────────────────────────
GCAL_CLIENT_ID =

// ──────────────────────────────────────────────────────────────
// Weather — OpenWeatherMap free tier
// https://openweathermap.org/api (One Call 3.0 requires sign-up)
// When empty, weather features show a graceful "unavailable" state.
// ──────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY =
